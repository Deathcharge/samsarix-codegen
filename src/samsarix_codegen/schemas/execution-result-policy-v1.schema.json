{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/execution-result-policy-v1.schema.json",
  "title": "Samsarix Codegen execution-result policy",
  "description": "Deterministic local limits applied to one validated execution-result envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "minProperties": 2,
  "properties": {
    "schema_version": {"const": 1},
    "expected_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]+$"
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12582912
    },
    "max_prompt_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_completion_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
