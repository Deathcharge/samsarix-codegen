{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/execution-result-verification-v2.schema.json",
  "title": "Samsarix Codegen execution-result verification",
  "description": "Content-omitting linkage metadata for one validated request and result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "result"],
  "properties": {
    "schema_version": {"const": 2},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "messages", "context_items", "context_bytes", "estimated_input_tokens"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "messages": {"type": "integer", "minimum": 1, "maximum": 32},
        "context_items": {"type": "integer", "minimum": 0, "maximum": 100},
        "context_bytes": {"type": "integer", "minimum": 0},
        "estimated_input_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "result": {"$ref": "#/$defs/result_summary"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optional_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "optional_model": {"anyOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]},
    "usage_value": {"type": ["integer", "null"], "minimum": 0},
    "result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_fingerprint", "model", "response_model", "response", "usage"],
      "properties": {
        "plan_fingerprint": {"$ref": "#/$defs/optional_fingerprint"},
        "model": {"$ref": "#/$defs/model"},
        "response_model": {"$ref": "#/$defs/optional_model"},
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chars", "bytes", "sha256"],
          "properties": {
            "chars": {"type": "integer", "minimum": 1, "maximum": 12582912},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 12582912},
            "sha256": {"$ref": "#/$defs/fingerprint"}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "prompt_tokens": {"$ref": "#/$defs/usage_value"},
            "completion_tokens": {"$ref": "#/$defs/usage_value"},
            "total_tokens": {"$ref": "#/$defs/usage_value"}
          }
        }
      }
    }
  }
}
