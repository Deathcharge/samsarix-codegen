{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Samsarix Codegen Request Artifact",
  "description": "A deterministic provider-neutral coding request artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_fingerprint",
    "messages",
    "context",
    "estimate"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "request_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_bytes", "items"],
      "properties": {
        "total_bytes": {"type": "integer", "minimum": 0},
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/context_record"}
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "method"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 1},
        "method": {"const": "ceil(total UTF-8 message bytes / 4)"}
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "content_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/fingerprint"}
      }
    }
  }
}
