{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/provider-check-v1.schema.json",
  "title": "Samsarix Codegen provider check",
  "description": "Content-safe evidence that one endpoint satisfied the supported Chat Completions wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "transport", "model", "request", "response", "usage"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "transport": {"const": "openai_chat_completions"},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_count", "source_context_items", "max_output_tokens", "stream"],
      "properties": {
        "message_count": {"const": 2},
        "source_context_items": {"const": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 256},
        "stream": {"const": false}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_received", "text_chars"],
      "properties": {
        "text_received": {"const": true},
        "text_chars": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
