{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/execution-evidence-verification-v3.schema.json",
  "title": "Samsarix Codegen execution-evidence verification",
  "description": "Content-omitting evidence that one request, reviewed plan, stored result, and optional exact result policy form a consistent local chain, including bounded JSON-object shape evidence when requested.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_fingerprint", "result_policy", "request", "provider", "budgets", "result"],
  "properties": {
    "schema_version": {"const": 3},
    "plan_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "result_policy": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint", "rules"],
          "properties": {
            "fingerprint": {"$ref": "#/$defs/fingerprint"},
            "rules": {
              "oneOf": [
                {"$ref": "#/$defs/result_policy_v1"},
                {"$ref": "#/$defs/result_policy_v2"}
              ]
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "messages", "context_items", "context_bytes", "estimated_input_tokens"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "messages": {"type": "integer", "minimum": 1, "maximum": 32},
        "context_items": {"type": "integer", "minimum": 0, "maximum": 100},
        "context_bytes": {"type": "integer", "minimum": 0},
        "estimated_input_tokens": {"type": "integer", "minimum": 1, "maximum": 2000000}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "requested_model", "response_model", "timeout_seconds", "max_output_tokens"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            {"pattern": "^https://(?:[^:/@?#\\s]+|\\[[0-9A-Fa-f:.]+\\])(?::[0-9]{1,5})?(?:/[^?#\\s]*)?$"},
            {"pattern": "^http://(?:localhost|127\\.(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){2}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\])(?::[0-9]{1,5})?(?:/[^?#\\s]*)?$"}
          ]
        },
        "requested_model": {"$ref": "#/$defs/model"},
        "response_model": {"$ref": "#/$defs/optional_model"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_estimated_input_tokens",
        "remaining_estimated_input_tokens",
        "reported_completion_tokens",
        "remaining_reported_output_tokens"
      ],
      "properties": {
        "max_estimated_input_tokens": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "remaining_estimated_input_tokens": {"type": "integer", "minimum": 0, "maximum": 2000000},
        "reported_completion_tokens": {"$ref": "#/$defs/usage_value"},
        "remaining_reported_output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 32768}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response", "response_structure", "usage"],
      "properties": {
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chars", "bytes", "sha256"],
          "properties": {
            "chars": {"type": "integer", "minimum": 1, "maximum": 12582912},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 12582912},
            "sha256": {"$ref": "#/$defs/fingerprint"}
          }
        },
        "response_structure": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "top_level_keys"],
              "properties": {
                "format": {"const": "json-object"},
                "top_level_keys": {"type": "integer", "minimum": 0, "maximum": 256}
              }
            }
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "prompt_tokens": {"$ref": "#/$defs/usage_value"},
            "completion_tokens": {"$ref": "#/$defs/usage_value"},
            "total_tokens": {"$ref": "#/$defs/usage_value"}
          }
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "optional_model": {"anyOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]},
    "usage_value": {"type": ["integer", "null"], "minimum": 0},
    "json_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "result_policy_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "minProperties": 2,
      "properties": {
        "schema_version": {"const": 1},
        "expected_model": {"$ref": "#/$defs/model"},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 12582912},
        "max_prompt_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "max_completion_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "max_total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "result_policy_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "minProperties": 2,
      "properties": {
        "schema_version": {"const": 2},
        "expected_model": {"$ref": "#/$defs/model"},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 12582912},
        "max_prompt_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "max_completion_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "max_total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "response_format": {"const": "json-object"},
        "required_json_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/json_key"}
        },
        "allowed_json_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/json_key"}
        },
        "json_key_types": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/json_key"},
          "additionalProperties": {"enum": ["array", "boolean", "integer", "null", "number", "object", "string"]}
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["required_json_keys"]},
              {"required": ["allowed_json_keys"]},
              {"required": ["json_key_types"]}
            ]
          },
          "then": {"required": ["response_format"]}
        }
      ]
    }
  }
}
