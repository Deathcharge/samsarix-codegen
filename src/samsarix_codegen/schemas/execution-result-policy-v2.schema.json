{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/execution-result-policy-v2.schema.json",
  "title": "Samsarix Codegen execution-result policy",
  "description": "Deterministic local metadata and bounded JSON-object shape rules applied to one validated execution-result envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "minProperties": 2,
  "properties": {
    "schema_version": {"const": 2},
    "expected_model": {"$ref": "#/$defs/model"},
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12582912
    },
    "max_prompt_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_completion_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "response_format": {"const": "json-object"},
    "required_json_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/json_key"}
    },
    "allowed_json_keys": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/json_key"}
    },
    "json_key_types": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/json_key"},
      "additionalProperties": {"enum": ["array", "boolean", "integer", "null", "number", "object", "string"]}
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"required": ["required_json_keys"]},
          {"required": ["allowed_json_keys"]},
          {"required": ["json_key_types"]}
        ]
      },
      "then": {"required": ["response_format"]}
    }
  ],
  "$defs": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]+$"
    },
    "json_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
