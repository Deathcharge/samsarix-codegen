{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/pilot-decision-v1.schema.json",
  "title": "Samsarix Codegen pilot decision evidence",
  "description": "Content-free evaluation of a valid privacy-minimal three-developer pilot record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "record_sha256",
    "wheel_sha256",
    "commit",
    "participants",
    "sessions",
    "workflows",
    "qualified_participants",
    "requirements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"enum": ["passed", "not-ready"]},
    "record_sha256": {"$ref": "#/$defs/fingerprint"},
    "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "participants": {"type": "integer", "minimum": 1, "maximum": 40},
    "sessions": {"type": "integer", "minimum": 1, "maximum": 40},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["staged-review", "log-triage"]}
    },
    "qualified_participants": {"type": "integer", "minimum": 0, "maximum": 40},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_least_three_participants",
        "every_participant_completed_staged_review",
        "both_workflows_exercised",
        "review_chain_completed",
        "successful_executions_have_passing_evidence",
        "at_least_two_qualified_participants",
        "safety_boundary_preserved"
      ],
      "properties": {
        "at_least_three_participants": {"type": "boolean"},
        "every_participant_completed_staged_review": {"type": "boolean"},
        "both_workflows_exercised": {"type": "boolean"},
        "review_chain_completed": {"type": "boolean"},
        "successful_executions_have_passing_evidence": {"type": "boolean"},
        "at_least_two_qualified_participants": {"type": "boolean"},
        "safety_boundary_preserved": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
