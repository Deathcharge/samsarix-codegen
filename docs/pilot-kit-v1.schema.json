{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/codegen/pilot-kit-v1.schema.json",
  "title": "Samsarix Codegen pilot-kit manifest",
  "description": "Content manifest linking one evaluator kit to an exact wheel and source commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "package_version",
    "source_commit",
    "wheel",
    "contents"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package": {"const": "samsarix-codegen"},
    "package_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "wheel": {"$ref": "#/$defs/content"},
    "contents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/content"}
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).*[^/]$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        }
      }
    }
  }
}
